# Aegis server deployment example.
# Copy to backend/.env and replace every placeholder before running scripts/server-up.sh.

APP_NAME=运维助手 Aegis API
APP_ENV=prod
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Required security settings. Use long random values in production.
SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=120
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Database option A: full SQLAlchemy URL.
# Keep this when using MySQL directly.
DATABASE_URL=mysql+pymysql://aegis_user:replace_with_db_password@127.0.0.1:3306/aegis?charset=utf8mb4

# Database option B: split MySQL fields.
# If MYSQL_HOST, MYSQL_USER and MYSQL_PASSWORD are set, they take precedence over DATABASE_URL.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_NAME=aegis
# MYSQL_USER=aegis_user
# MYSQL_PASSWORD=replace_with_db_password
# MYSQL_CHARSET=utf8mb4

# CORS. Add your real server IP/domain and the mobile/admin ports.
CORS_ALLOW_ORIGINS=https://127.0.0.1:5173,https://127.0.0.1:5174,https://your_server_ip_or_domain:5173,https://your_server_ip_or_domain:5174
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0|192\\.168\\.\\d+\\.\\d+|10\\.\\d+\\.\\d+\\.\\d+|172\\.(1[6-9]|2\\d|3[0-1])\\.\\d+\\.\\d+)(:\\d+)?$
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# AI provider routing.
# Use "ollama" for local offline AI, "openclaw" for an OpenClaw-compatible AI service,
# or "internal_gateway" for the Aegis internal AI gateway.
AI_PROVIDER=ollama
AI_FALLBACK_PROVIDER=mock

# Offline AI through Ollama.
OFFLINE_AI_ENABLED=true
OFFLINE_AI_PROVIDER=ollama
OFFLINE_AI_MODEL=qwen2.5:7b
OFFLINE_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
OFFLINE_AI_TIMEOUT_SECONDS=120

# OpenClaw-compatible AI service. Required when AI_PROVIDER=openclaw.
OPENCLAW_BASE_URL=
OPENCLAW_API_KEY=
OPENCLAW_TIMEOUT_SECONDS=120
OPENCLAW_MODEL=openclaw
OPENCLAW_RESPONSES_PATH=/v1/responses

# Internal AI gateway. The gateway can adapt to pi-agent or other AI providers.
# Required when AI_PROVIDER=internal_gateway.
INTERNAL_AI_GATEWAY_BASE_URL=
INTERNAL_AI_GATEWAY_API_KEY=
INTERNAL_AI_GATEWAY_TIMEOUT_SECONDS=120
INTERNAL_AI_GATEWAY_PROVIDER=pi-agent
INTERNAL_AI_GATEWAY_MODEL=pi-agent
INTERNAL_AI_GATEWAY_CHAT_PATH=/v1/chat
INTERNAL_AI_GATEWAY_DIAGNOSE_PATH=/v1/diagnose
INTERNAL_AI_GATEWAY_LOG_ANALYZE_PATH=/v1/log-analyze

# Optional Aegis OpenClaw adapter endpoints.
OPENCLAW_ADAPTER_ENABLED=false
OPENCLAW_ADAPTER_TOKEN=replace_with_adapter_token
OPENCLAW_CHAT_PATH=/aegis/ai/chat
OPENCLAW_DIAGNOSE_PATH=/aegis/ai/diagnose
OPENCLAW_LOG_ANALYZE_PATH=/aegis/ai/log-analyze

# Optional threat intelligence API.
THREATBOOK_API_KEY=
THREATBOOK_TIMEOUT_SECONDS=30
