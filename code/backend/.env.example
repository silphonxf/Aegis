SECRET_KEY=change_me_to_a_long_random_secret
INIT_ADMIN_PASSWORD=change_me_to_a_strong_password
DATABASE_URL=sqlite:///./aegis.db
APP_ENV=dev

# Redis cache for DB-backed config/reference data.
REDIS_CACHE_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_TTL_SECONDS=300
EMERGENCY_CONFIG_AUTO_IMPORT_JSON=true

# Local development CORS defaults allow localhost, private LAN ranges, and Tailscale 100.64.0.0/10.
# Override this only when you need a stricter deployment policy.
# CORS_ALLOW_ORIGINS=https://127.0.0.1:5173,https://127.0.0.1:5174

# AI provider routing.
# Use "ollama", "openclaw", or "internal_gateway".
# AI_PROVIDER=internal_gateway

# Internal AI gateway. The first target provider is pi-agent.
# INTERNAL_AI_GATEWAY_BASE_URL=https://your-ai-gateway.example.com
# INTERNAL_AI_GATEWAY_API_KEY=replace_with_gateway_token
# INTERNAL_AI_GATEWAY_PROVIDER=pi-agent
# INTERNAL_AI_GATEWAY_MODEL=pi-agent
# INTERNAL_AI_GATEWAY_TIMEOUT_SECONDS=120
# INTERNAL_AI_GATEWAY_CHAT_PATH=/v1/chat
# INTERNAL_AI_GATEWAY_DIAGNOSE_PATH=/v1/diagnose
# INTERNAL_AI_GATEWAY_LOG_ANALYZE_PATH=/v1/log-analyze

# Hillstone StoneOS REST API firewall block executor.
# Keep dry_run=true in API requests until these credentials and addrbook path are verified.
# HILLSTONE_ENABLED=true
# HILLSTONE_SCHEME=https
# HILLSTONE_HOST=192.168.100.18
# HILLSTONE_PORT=443
# HILLSTONE_USERNAME=
# HILLSTONE_PASSWORD=
# HILLSTONE_VERIFY_SSL=false
# HILLSTONE_TIMEOUT_SECONDS=15
# HILLSTONE_ADDRESS_BOOK_NAME=aegis-blocked-ip
# HILLSTONE_ADDRBOOK_PATH=/api/addrbook
# HILLSTONE_ADDRBOOK_METHOD=PUT
# HILLSTONE_ADDRBOOK_TYPE=1
