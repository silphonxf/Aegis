APP_NAME=运维助手 Aegis API
APP_ENV=prod
API_PREFIX=/api/v1
SECRET_KEY=change_me_to_a_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 方案 A：直接给完整连接串
DATABASE_URL=mysql+pymysql://aegis_user:StrongPass_123@127.0.0.1:3306/aegis?charset=utf8mb4

# 方案 B：拆分字段（配置了 MYSQL_* 时会优先于 DATABASE_URL）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_NAME=aegis
MYSQL_USER=aegis_user
MYSQL_PASSWORD=StrongPass_123
MYSQL_CHARSET=utf8mb4

INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123

# 离线 AI（Ollama + Qwen）
OFFLINE_AI_ENABLED=true
OFFLINE_AI_PROVIDER=ollama
OFFLINE_AI_MODEL=qwen2.5:7b
OFFLINE_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
OFFLINE_AI_TIMEOUT_SECONDS=120
