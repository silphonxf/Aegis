# Aegis backend local development example
APP_NAME=运维助手 Aegis API
APP_ENV=dev
API_PREFIX=/api/v1

# Required security settings
SECRET_KEY=change_me_to_a_long_random_secret
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=change_me_to_a_strong_password

# Local development database (SQLite)
DATABASE_URL=sqlite:///./aegis.db

# Optional Dameng split config (takes precedence over DATABASE_URL when set)
# DM_HOST=127.0.0.1
# DM_PORT=5236
# DM_NAME=SYSDBA
# DM_USER=SYSDBA
# DM_PASSWORD=YourPassword

# AI provider routing
AI_PROVIDER=ollama
AI_FALLBACK_PROVIDER=mock
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_API_KEY=
OPENCLAW_TIMEOUT_SECONDS=120
OPENCLAW_MODEL=openclaw
OPENCLAW_RESPONSES_PATH=/v1/responses
OPENCLAW_ADAPTER_ENABLED=false
OPENCLAW_ADAPTER_TOKEN=local-dev-openclaw-token
OPENCLAW_CHAT_PATH=/aegis/ai/chat
OPENCLAW_DIAGNOSE_PATH=/aegis/ai/diagnose
OPENCLAW_LOG_ANALYZE_PATH=/aegis/ai/log-analyze

# Offline AI
OFFLINE_AI_ENABLED=true
OFFLINE_AI_PROVIDER=ollama
OFFLINE_AI_MODEL=qwen2.5:7b
OFFLINE_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
OFFLINE_AI_TIMEOUT_SECONDS=120

# ThreatBook
THREATBOOK_API_KEY=
THREATBOOK_TIMEOUT_SECONDS=30

# CORS
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
