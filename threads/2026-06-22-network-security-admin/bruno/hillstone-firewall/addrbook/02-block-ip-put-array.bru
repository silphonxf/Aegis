meta {
  name: 02 Block IP PUT Addrbook
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/rest/api/addrbook
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: token={{token}}; role={{role}}; vsysId={{vsysId}}; fromrootvsys={{fromrootvsys}}; username={{username}}
}

body:json {
  {
    "is_ipv6": 0,
    "type": 0,
    "name": "{{addrbookName}}",
    "description": "",
    "entry": [],
    "ip": [
      {
        "ip_addr": "216.250.248.88",
        "netmask": 32,
        "flag": 0
      },
      {
        "ip_addr": "16.163.96.158",
        "netmask": 32,
        "flag": 0
      },
      {
        "ip_addr": "{{targetIp}}",
        "netmask": 32,
        "flag": 0
      }
    ],
    "range": [],
    "host": [],
    "wildcard": [],
    "country": []
  }
}
